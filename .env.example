# Copy to .env and adjust as needed. `.env` is git-ignored (§10: no secrets in code).
# docker compose reads this file automatically.

# --- Postgres ---
POSTGRES_USER=leads
POSTGRES_PASSWORD=leads
POSTGRES_DB=leads
# Host port to publish the DB on. Change this (e.g. 5433) if you already run a
# native PostgreSQL on 5432; the container/internal port stays 5432 regardless.
DB_HOST_PORT=5432

# --- Auth ---
# Generate a strong value for anything beyond local dev, e.g. `openssl rand -hex 32`.
JWT_SECRET=dev-secret-change-me

# --- Object storage (MinIO locally; swap for real S3 creds in prod) ---
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=resumes

# --- Email ---
EMAIL_FROM=Leads Tracker <no-reply@leads.local>
DASHBOARD_URL=http://localhost:3000/leads

# --- Seeded demo attorney (created on first boot) ---
SEED_ATTORNEY_EMAIL=attorney@example.com
SEED_ATTORNEY_PASSWORD=attorney123
SEED_ATTORNEY_NAME=Attorney Admin

# --- Misc ---
LOG_LEVEL=INFO
